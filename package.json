  },
  "keywords": [
    "internal-links",
    "internal-link-visualization",
    "seo",
    "seo-crawler",
    "crawler",
    "sitemap",
    "link-graph",
    "edge-list",
    "gexf",
    "graphml",
    "cytoscape"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/partick33/internal-links-export.git"
  }
